{
  "name": "@ticket-assistant/core",
  "version": "1.0.1",
  "main": "./index.js",
  "types": "./index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./storage": "./storage/index.js",
    "./ai": "./ai/index.js",
    "./utils/*": "./utils/*.js",
    "./models/*": "./models/*.js",
    "./*": "./*"
  },
  "type": "module",
  "files": [
    "index.js",
    "index.d.ts",
    "ai",
    "controllers",
    "middlewares",
    "models",
    "routes",
    "storage",
    "utils",
    "README.md"
  ],
  "scripts": {
    "dev": "nodemon server.js"
  },
  "keywords": [
    "ticket",
    "support",
    "ai",
    "helpdesk",
    "triage"
  ],
  "author": "Rudra",
  "license": "ISC",
  "description": "Headless, AI-powered support ticket triage and assignment framework",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rudra2637/Ai-Ticket-Assistant.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Rudra2637/Ai-Ticket-Assistant/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/Rudra2637/Ai-Ticket-Assistant/issues"
  },
  "peerDependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "cors": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "nodemon": "^3.1.11"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "dotenv": "^17.2.3",
    "mongoose": "^8.20.0",
    "nodemailer": "^7.0.10"
  }
}

